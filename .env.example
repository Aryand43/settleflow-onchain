# SettleFlow prototype environment variables

# --- Required for local demo ---
DEMO_MODE=true
DATABASE_URL=sqlite:///./settleflow.db
API_KEY=dev-key

# --- Optional: hosted Postgres via Supabase ---
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Use the *Session pooler* (port 5432). The URL Supabase gives you starts with
# `postgresql://` and works pasted as-is; the app rewrites it onto psycopg 3.
# The password is URL-encoded, so escape any of @ : / ? # in it.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
WEB_BASE_URL=http://localhost:3000
MERCHANT_NAME=SettleFlow Demo Merchant
MERCHANT_WALLET=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=dev-key
NEXT_PUBLIC_DEMO_MODE=true

# --- Optional: LLM command parsing ---
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# --- Optional: Base Sepolia testnet ---
# CHAIN_ID=84532
# RPC_URL=https://sepolia.base.org
# PAYMENT_CONTRACT_ADDRESS=
# USDC_CONTRACT_ADDRESS=
# MERCHANT_PRIVATE_KEY=   # Never commit a real key

# --- Optional: Google Sheets (post-prototype) ---
# GOOGLE_SHEETS_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Optional: SMTP email (post-prototype) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=
