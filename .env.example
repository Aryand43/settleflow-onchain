# SettleFlow prototype environment variables

# --- Required for local demo ---
DEMO_MODE=true
DATABASE_URL=sqlite:///./settleflow.db
API_KEY=dev-key

# --- Optional: hosted Postgres via Supabase ---
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Use the *Session pooler* (port 5432). The URL Supabase gives you starts with
# `postgresql://` and works pasted as-is; the app rewrites it onto psycopg 3.
# The password is URL-encoded, so escape any of @ : / ? # in it.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
WEB_BASE_URL=http://localhost:3000
MERCHANT_NAME=SettleFlow Demo Merchant
MERCHANT_WALLET=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Frontend
# NEXT_PUBLIC_API_KEY is gone: the dashboard authenticates with a per-user JWT
# now, so the admin key no longer ships to the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true

# --- Auth ---
# Signs dashboard sessions. Fine for local demos; anything internet-reachable
# MUST set its own, or every session token this app issues is forgeable.
JWT_SECRET=dev-secret-change-me

# --- Email delivery (SMTP) ---
# NOTE: Docker Compose reads the .env in the REPO ROOT, not this copy in
# apps/api/.env. Set these in both if you run the app both ways.
# Leave SMTP_HOST blank and reminders are written to apps/api/email_previews/
# as HTML files instead of being sent. Fill it in and they really go out.
#
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords — the normal account password will
# not work. Paste the 16 characters below (spaces are fine to strip).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=settleflowhackathon@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=settleflowhackathon@gmail.com
EMAIL_FROM_NAME=SettleFlow

# Points every seeded customer at one inbox you control, so a live email demo
# actually lands somewhere you can open. Uses +tags to keep them apart.
# DEMO_CUSTOMER_EMAIL=settleflowhackathon@gmail.com

# --- LLM (command parsing + merchant chat) ---
# Paste an OpenAI-compatible key here. Same key powers:
#   - free-form invoice command parsing
#   - natural-language payment queries on /invoices
#   - the overview chatbot on the dashboard
# Leave blank to keep regex parsing and hide the chat input.
# The key stays on the API — never put it in NEXT_PUBLIC_* vars.
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1

# --- Optional: Base Sepolia testnet ---
# CHAIN_ID=84532
# RPC_URL=https://sepolia.base.org
# PAYMENT_CONTRACT_ADDRESS=
# USDC_CONTRACT_ADDRESS=
# MERCHANT_PRIVATE_KEY=   # Never commit a real key

# --- Optional: Google Sheets (post-prototype) ---
# GOOGLE_SHEETS_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=

